<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>YouEDA.CLI</AssemblyName>
    <RootNamespace>YouEDA.CLI</RootNamespace>
    <YouEdaRoot Condition="'$(YouEdaRoot)' == ''">$(MSBuildProjectDirectory)\..\..\third_party\YouEDA</YouEdaRoot>
    <AltiumSharpRoot Condition="'$(AltiumSharpRoot)' == ''">$(MSBuildProjectDirectory)\..\..\third_party\AltiumSharp</AltiumSharpRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(AltiumSharpRoot)\src\OriginalCircuit.Altium\OriginalCircuit.Altium.csproj" />
    <ProjectReference Include="$(AltiumSharpRoot)\shared\OriginalCircuit.Eda.Abstractions\src\OriginalCircuit.Eda.Abstractions\OriginalCircuit.Eda.Abstractions.csproj" />

    <!-- The production conversion engine is shared with the desktop YouEDA project. -->
    <Compile Include="$(YouEdaRoot)\src\YouEDA.Cli\Program.cs" Link="Program.cs" />
    <Compile Include="$(YouEdaRoot)\src\Models\**\*.cs" Link="Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(YouEdaRoot)\src\Services\AltiumSchExporter.cs" Link="Services\AltiumSchExporter.cs" />
    <Compile Include="$(YouEdaRoot)\src\Services\AltiumV2Exporter.cs" Link="Services\AltiumV2Exporter.cs" />
    <Compile Include="$(YouEdaRoot)\src\Services\BulkLibraryWriter.cs" Link="Services\BulkLibraryWriter.cs" />
    <Compile Include="$(YouEdaRoot)\src\Services\EasyEda3dModelDownloader.cs" Link="Services\EasyEda3dModelDownloader.cs" />
    <Compile Include="$(YouEdaRoot)\src\Services\LcscScraper.cs" Link="Services\LcscScraper.cs" />
    <Compile Include="$(YouEdaRoot)\src\Services\Parser.cs" Link="Services\Parser.cs" />
    <Compile Include="$(YouEdaRoot)\src\Services\UserSymbolLibraryResolver.cs" Link="Services\UserSymbolLibraryResolver.cs" />

    <Content Include="$(AltiumSharpRoot)\TestData\PCB - DIODES - DIODES INC SDT10A45P5.PCBLIB" Link="Templates\AltiumTemplate.PcbLib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(YouEdaRoot)\src\Assets\BundledUserSymbols.SchLib" Link="Symbols\BundledUserSymbols.SchLib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
